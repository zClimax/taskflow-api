# ─────────────────────────────────────────────────────────────────────────────
# TASKFLOW API — Variables de Entorno para PRODUCCIÓN
#
# ¡NUNCA subas este archivo a GitHub!
# Las variables de producción se configuran directamente en Railway:
#   Dashboard → tu proyecto → Variables
#
# Este archivo es solo de referencia — muestra qué variables necesitas
# configurar en Railway. Cada valor debe ser único y seguro en producción.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
API_VERSION=v1

# ─── Base de Datos ────────────────────────────────────────────────────────────
# Railway provee esta variable automáticamente cuando añades el plugin PostgreSQL
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# CRÍTICO: Genera valores únicos y seguros:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ¡Estos valores son diferentes a los de desarrollo!
# Si alguien conoce el JWT_ACCESS_SECRET puede crear tokens válidos.
JWT_ACCESS_SECRET="GENERAR_CON_CRYPTO_RANDOMBYTES_64"
JWT_REFRESH_SECRET="GENERAR_CON_CRYPTO_RANDOMBYTES_64_DIFERENTE"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL de tu frontend en producción (no localhost)
CORS_ORIGIN="https://tu-frontend.vercel.app"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
