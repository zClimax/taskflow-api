# ─────────────────────────────────────────────────────────────────────────────
# TASKFLOW API — Variables de Entorno
#
# Este archivo ES el template. Cópialo a ".env" y llena los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).
# Este archivo ".env.example" SÍ se sube — sirve de documentación para otros devs.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Aplicación ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─── Base de Datos ────────────────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_de_datos
DATABASE_URL="postgresql://jorge:password@localhost:5432/taskflow_dev"

# ─── Autenticación JWT ────────────────────────────────────────────────────────
# IMPORTANTE: En producción, usa una cadena aleatoria larga (mínimo 32 caracteres)
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="tu_secreto_de_access_token_muy_largo_y_aleatorio"
JWT_REFRESH_SECRET="tu_secreto_de_refresh_token_muy_largo_y_diferente"

# Duración del access token (short-lived: minutos u horas)
JWT_ACCESS_EXPIRES_IN="15m"
# Duración del refresh token (long-lived: días o semanas)
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URLs que tienen permiso de hacer peticiones a tu API
# En desarrollo: el frontend local
# En producción: tu dominio real
CORS_ORIGIN="http://localhost:5173"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Número máximo de peticiones por ventana de tiempo
RATE_LIMIT_MAX=100
# Ventana de tiempo en milisegundos (900000ms = 15 minutos)
RATE_LIMIT_WINDOW_MS=900000

# ─── Email (Módulo 7 - opcional por ahora) ────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=tu_app_password
